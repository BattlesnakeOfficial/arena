  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            c.id,\n            c.public_client_id,\n            c.secret_hash,\n            c.name,\n            c.logo_url,\n            c.homepage_url,\n            c.kind as \"kind: OauthClientKind\",\n            c.created_at,\n            c.disabled_at,\n            ARRAY(\n                SELECT uri FROM oauth_client_redirect_uris u\n                WHERE u.oauth_client_id = c.id\n                ORDER BY uri\n            ) AS \"redirect_uris!: Vec<String>\"\n        FROM oauth_clients c\n        ORDER BY c.name ASC\n        ",
