{
  "db_name": "PostgreSQL",
  "query": "\n        INSERT INTO users (\n            external_github_id, github_login, github_avatar_url, github_name, github_email\n        )\n        VALUES ($1, $2, $3, $4, $5)\n        ON CONFLICT (external_github_id) DO UPDATE SET\n            github_login = $2,\n            github_avatar_url = $3,\n            github_name = $4,\n            github_email = $5\n        RETURNING\n            user_id,\n            external_github_id,\n            github_login,\n            github_avatar_url,\n            github_name,\n            github_email,\n            display_name,\n            pronouns,\n            country,\n            backstory,\n            is_admin,\n            site_theme,\n            theater_theme,\n            created_at,\n            updated_at\n        ",
