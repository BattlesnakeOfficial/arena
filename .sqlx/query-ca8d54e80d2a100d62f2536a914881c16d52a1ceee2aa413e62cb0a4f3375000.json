  "query": "\n        SELECT game_type, board_size, status, created_at, finished_at, archived_at\n        FROM games\n        WHERE game_id = $1\n          AND engine_game_id IS NULL\n          AND status IN ('finished', 'failed')\n          AND turns_pruned_at IS NULL\n        ",
