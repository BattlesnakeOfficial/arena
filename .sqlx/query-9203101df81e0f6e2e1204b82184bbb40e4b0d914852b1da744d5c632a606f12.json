  "query": "SELECT r.disabled_at IS NOT NULL AS \"disabled!\", r.disabled_reason,\n                      r.health_consecutive_failures, r.health_consecutive_successes,\n                      r.health_last_failure, r.health_last_checked_at\n             FROM leaderboard_registrations r\n             JOIN leaderboard_entries le\n               ON le.leaderboard_id = r.leaderboard_id AND le.battlesnake_id = r.battlesnake_id\n             WHERE le.leaderboard_entry_id = $1",
