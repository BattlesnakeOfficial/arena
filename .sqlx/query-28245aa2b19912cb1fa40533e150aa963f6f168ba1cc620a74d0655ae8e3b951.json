  "query": "\n        SELECT\n            battlesnake_id,\n            user_id,\n            name,\n            url,\n            visibility as \"visibility: Visibility\",\n            engine_region as \"engine_region: EngineRegion\",\n            color,\n            head,\n            tail,\n            created_at,\n            updated_at\n        FROM battlesnakes\n        WHERE (user_id = $1 OR visibility = 'public')\n          AND deleted_at IS NULL\n        ORDER BY name ASC\n        ",
