  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                battlesnake_id,\n                user_id,\n                name,\n                url,\n                visibility as \"visibility: _\",\n                engine_region as \"engine_region: _\",\n                color,\n                head,\n                tail,\n                created_at,\n                updated_at,\n                retired_at\n            FROM battlesnakes\n            WHERE battlesnake_id = ANY($1)\n              AND (user_id = $2 OR visibility = 'public')\n              AND deleted_at IS NULL\n              AND retired_at IS NULL\n            ORDER BY name ASC\n            ",
