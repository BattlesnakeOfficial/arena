  "query": "\n        SELECT\n            game_id,\n            board_size,\n            game_type,\n            status,\n            enqueued_at,\n            created_at,\n            updated_at,\n            engine_game_id,\n            gcs_path\n        FROM games\n        WHERE game_id = $1 OR engine_game_id = $2\n        ORDER BY (game_id = $1) DESC\n        LIMIT 1\n        ",
