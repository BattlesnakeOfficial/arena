  "monitors": [
    {
      "enabled": true,
      "expected_status_max": 299,
      "expected_status_min": 200,
      "failure_threshold": 3,
      "id": "health",
      "interval_seconds": 60,
      "method": "GET",
      "target": "/health",
      "timeout_seconds": 10
    }
  ],
  "thresholds": [
    {
      "critical": {
        "comparison": "above",
        "threshold": 30000.0
      },
      "description": "Game queue delay",
      "enabled": true,
      "evaluation_delay_seconds": 30,
      "evaluation_interval_seconds": 60,
      "failure_threshold": 3,
      "group_match": "any",
      "id": "game-queue-delay",
      "metric_id": "game.queue_wait.p95",
      "recovery_threshold": 2,
      "warning": {
        "comparison": "above",
        "threshold": 10000.0
      },
      "window_seconds": 300
    },
    {
      "critical": {
        "comparison": "above",
        "threshold": 3000.0
      },
      "description": "Turn persistence latency",
      "enabled": true,
      "evaluation_delay_seconds": 30,
      "evaluation_interval_seconds": 60,
      "failure_threshold": 3,
      "group_match": "any",
      "id": "turn-storage-latency",
      "metric_id": "game.db_write.p95",
